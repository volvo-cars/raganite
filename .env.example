# Copy to .env in your working directory; never commit .env or real credentials.
# CLI: raganite [common options] COMMAND [command/common options]
# Alternative before installation: python -m raganite.cli COMMAND
# Uses Click; run raganite --help or raganite COMMAND --help for options/defaults.
# Quick start: copy this file to .env, replace OPENAI_API_KEY, then run:
#   raganite index ./documents
#   raganite retrieve 'What does this project do?'
# No database service or extra settings needed: SQLite storage is created during
# indexing. All RAGANITE_* lines below are OPTIONAL overrides; commented values
# document built-in defaults unless explicitly described as examples.
#
# Commands:
#   raganite init                         Create/validate storage and indexes.
#   raganite config                       Print resolved settings; secrets masked.
#   raganite index ./documents --source docs
#   raganite index                        Index the current directory.
#   raganite index notes.txt --source docs --document-path notes.txt
#   printf 'Some text' | raganite index - --source docs --document-path note
#   raganite retrieve 'What does this project do?' --top-k 5 --format text
#   raganite clear --source docs --yes     Destructive; omit source for namespace.
# Indexing a directory synchronizes its source, including removal of stale files.
# Retrieval returns passages/evidence, NOT a generated answer; it opens read-only.
# init/config/clear do not construct model clients or require model credentials.
#
# Precedence (highest first): explicit CLI options, existing process environment,
# this dotenv file, --config settings.json/settings.toml, built-in defaults.
# Only .env in the current directory is auto-loaded; no parent-directory search.
# Use --env-file PATH to select a file, or --no-env-file to skip dotenv loading.
# Library constructors do not automatically load dotenv files.
#
# Booleans: true/false. Lists/objects: JSON in single quotes. Do not set optional
# numeric values to empty strings: leave them commented to keep their defaults.
# Nested keys use __. Every RaganiteConfig field is listed below. Entire objects
# may also be supplied as JSON: RAGANITE_BACKEND, RAGANITE_CHAT,
# RAGANITE_EMBEDDINGS, RAGANITE_INDEXING, RAGANITE_RETRIEVAL, and nested objects
# such as RAGANITE_INDEXING__CHUNKING. Nested __ keys override JSON object keys.

# ---------------------------------------------------------------------------
# Graph identity and vector size
# ---------------------------------------------------------------------------
# RAGANITE_NAMESPACE=default
# Positive integer; must match indexed vectors and the embedding model output.
# text-embedding-3-small: 1536; text-embedding-3-large: 3072 unless shortened.
# RAGANITE_EMBEDDING_DIMENSIONS=1536

# ---------------------------------------------------------------------------
# Backend: sqlite (default) OR neo4j. Only enable keys for the selected kind.
# Do not leave SQLite-only keys enabled when switching to Neo4j or vice versa.
# ---------------------------------------------------------------------------
# RAGANITE_BACKEND__KIND=sqlite
# File path or :memory: (ephemeral; unsuitable across separate CLI commands).
# RAGANITE_BACKEND__PATH=.raganite/graph.sqlite3
# SQLite lock wait in seconds; positive number.
# RAGANITE_BACKEND__TIMEOUT=30
# true prevents writes. Retrieval CLI forces true regardless of this setting.
# RAGANITE_BACKEND__READ_ONLY=false

# Replace the SQLite settings above with these when using Neo4j:
# RAGANITE_BACKEND__KIND=neo4j
# owned = namespace-scoped Raganite graph; native = existing dedicated database.
# native is always read-only and uses its existing topology/indexes.
# RAGANITE_BACKEND__LAYOUT=owned
# URI schemes include bolt://, neo4j://, neo4j+s:// (TLS; deployment-dependent).
# RAGANITE_BACKEND__URI=bolt://localhost:7687
# RAGANITE_BACKEND__USERNAME=neo4j
# RAGANITE_BACKEND__PASSWORD=replace-with-neo4j-password
# RAGANITE_BACKEND__DATABASE=neo4j
# Index names; owned layout scopes these by namespace automatically.
# For the existing HotpotQA graph, use chunk_embeddings/chunk_fulltext/fact_embeddings.
# RAGANITE_BACKEND__VECTOR_INDEX=raganite_chunks_vector
# RAGANITE_BACKEND__FULLTEXT_INDEX=raganite_chunks_fulltext
# RAGANITE_BACKEND__FACT_VECTOR_INDEX=raganite_facts_vector
# Native neo4j.GraphDatabase.driver keyword arguments as JSON (not URI/auth).
# RAGANITE_BACKEND__DRIVER_OPTIONS='{"max_connection_pool_size":50,"connection_timeout":30}'

# ---------------------------------------------------------------------------
# CLI chat and embedding clients (configured independently)
# ---------------------------------------------------------------------------
# Provider values: openai | azure-openai. The Python client wrappers remain native
# LangChain wrappers; these settings select clients for the CLI only.
# RAGANITE_CHAT__PROVIDER=openai
# RAGANITE_CHAT__MODEL=gpt-4o
# RAGANITE_EMBEDDINGS__PROVIDER=openai
# RAGANITE_EMBEDDINGS__MODEL=text-embedding-3-small

# Native LangChain constructor kwargs as JSON; no custom retry algorithm.
# Model/API-version fields belong above, not inside OPTIONS.
# max_retries counts retries AFTER the initial attempt. SDK backoff honors
# supported Retry-After headers, otherwise uses exponential backoff with jitter.
# Timeout values are seconds; available kwargs depend on the selected class.
# RAGANITE_CHAT__OPTIONS='{"max_retries":4,"timeout":120,"use_responses_api":false}'
# RAGANITE_EMBEDDINGS__OPTIONS='{"max_retries":4,"request_timeout":120,"chunk_size":1000}'
# To shorten text-embedding-3 vectors, set dimensions explicitly in OPTIONS and
# set RAGANITE_EMBEDDING_DIMENSIONS to that SAME size before indexing/querying.
# RAGANITE_EMBEDDINGS__OPTIONS='{"dimensions":1536,"max_retries":4}'

# OpenAI credentials are resolved by LangChain/OpenAI, not stored in model config.
OPENAI_API_KEY=replace-with-openai-api-key
# Optional organization / custom OpenAI endpoint. Prefer per-client OPTIONS when
# chat and embedding endpoints differ. Custom endpoints must support the API.
# OPENAI_ORG_ID=replace-with-organization-id
# OPENAI_API_BASE=https://api.openai.com/v1
# OPENAI_PROXY=http://localhost:8080

# Azure: replace BOTH provider/model settings above. Model = deployment name,
# which may differ from the underlying model ID.
# RAGANITE_CHAT__PROVIDER=azure-openai
# RAGANITE_CHAT__MODEL=your-chat-deployment
# RAGANITE_EMBEDDINGS__PROVIDER=azure-openai
# RAGANITE_EMBEDDINGS__MODEL=your-embedding-deployment
# Resource URL, not an individual deployment URL. Azure v1 appends /openai/v1/.
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
# AZURE_OPENAI_API_KEY=replace-with-azure-openai-api-key
# Alternatively, a short-lived Entra bearer token; prefer token providers in the
# Python API for long-running services. Never commit tokens.
# AZURE_OPENAI_AD_TOKEN=replace-with-entra-token

# Azure v1 (default): LEAVE API_VERSION unset. No dated api-version is sent.
# For a traditional dated Azure endpoint, set BOTH versions explicitly to the
# values supported by your deployments. These strings are examples, not defaults.
# RAGANITE_CHAT__API_VERSION=2024-12-01-preview
# RAGANITE_EMBEDDINGS__API_VERSION=2024-02-01
# Use OPTIONS for per-client base_url/api_key/azure_endpoint or other native kwargs.
# These can contain secrets: keep real values only in untracked .env/config files.

# ---------------------------------------------------------------------------
# Indexing and chunking
# ---------------------------------------------------------------------------
# Positive worker count; unset = CPU allocation/os.cpu_count(), minimum 1.
# RAGANITE_INDEXING__WORKERS=4
# fixed = neo4j-graphrag FixedSizeSplitter; recursive/character = LangChain.
# RAGANITE_INDEXING__CHUNKING__STRATEGY=fixed
# RAGANITE_INDEXING__CHUNKING__CHUNK_SIZE=1500
# Non-negative; strictly less than chunk_size. Units follow the chosen splitter.
# RAGANITE_INDEXING__CHUNKING__CHUNK_OVERLAP=200
# Extra native LangChain splitter kwargs; never duplicate size/overlap here.
# RAGANITE_INDEXING__CHUNKING__OPTIONS='{"separators":["\n\n","\n"," ",""]}'
# Schema mode: fixed = supplied/default code ontology; free = unconstrained;
# extracted = infer schema from input. See --schema FILE for a JSON schema file.
# RAGANITE_INDEXING__SCHEMA_MODE=fixed
# Omit to use default_schema(); null disables an explicitly supplied schema.
# Object format is neo4j-graphrag GraphSchema, not JSON Schema.
# RAGANITE_INDEXING__GRAPH_SCHEMA='{"node_types":[{"label":"Person"}],"relationship_types":[{"label":"KNOWS"}],"patterns":[{"source":"Person","relationship":"KNOWS","target":"Person"}]}'
# RAGANITE_INDEXING__GRAPH_SCHEMA=null
# RAGANITE_INDEXING__PERFORM_ENTITY_RESOLUTION=true
# Extraction behavior: RAISE | IGNORE (indexing reports failed documents).
# RAGANITE_INDEXING__ON_ERROR=RAISE
# Custom extractor prompt template; omit for neo4j-graphrag's default.
# RAGANITE_INDEXING__EXTRACTION_PROMPT='your-compatible-extraction-prompt-template'
# Optional few-shot examples passed to the extractor.
# RAGANITE_INDEXING__EXAMPLES='your-extraction-examples'
# Keep true for the default fact-based retriever; embeds extracted relationships.
# RAGANITE_INDEXING__INDEX_FACTS=true
# Positive byte limit for repository/directory scanning.
# RAGANITE_INDEXING__MAX_FILE_BYTES=1000000
# JSON glob lists; include matches filenames; exclude matches relative/full paths.
# RAGANITE_INDEXING__INCLUDE_GLOBS='["*.py","*.md","*.rst","*.txt","*.json","*.yaml","*.yml","*.toml","*.ini","*.cfg"]'
# RAGANITE_INDEXING__EXCLUDE_GLOBS='["*/.git/*","*/.venv/*","*/venv/*","*/node_modules/*","*/__pycache__/*","*/.mypy_cache/*","*/.pytest_cache/*","*/dist/*","*/build/*","*.lock"]'

# ---------------------------------------------------------------------------
# Fact retrieval: fact search -> LLM filter -> graph expansion -> RRF -> rerank
# ---------------------------------------------------------------------------
# Positive worker count; unset = available CPU count. Lower for API rate limits.
# RAGANITE_RETRIEVAL__WORKERS=4
# Candidate/fused passage cap, not the CLI output count (--top-k defaults to 5).
# RAGANITE_RETRIEVAL__TOP_K=200
# RAGANITE_RETRIEVAL__TRIPLE_TOP_K=30
# Positive; cannot exceed triple_top_k.
# RAGANITE_RETRIEVAL__FILTERED_TRIPLE_K=8
# Integer depth 0..5; 0 still includes seed-entity passages.
# RAGANITE_RETRIEVAL__EXPANSION_DEPTH=2
# RAGANITE_RETRIEVAL__EXPANSION_LIMIT=5000
# Finite, non-negative weights; larger degree penalty suppresses hub entities.
# RAGANITE_RETRIEVAL__DEGREE_PENALTY_WEIGHT=0.25
# RAGANITE_RETRIEVAL__GRAPH_WEIGHT=1.0
# Positive reciprocal-rank-fusion constant and LLM rerank candidate count.
# RAGANITE_RETRIEVAL__RRF_K=60
# RAGANITE_RETRIEVAL__RERANK_TOP_K=20
# RAGANITE_RETRIEVAL__USE_TRIPLES=true
# RAGANITE_RETRIEVAL__FILTER_TRIPLES=true
# RAGANITE_RETRIEVAL__RERANK_PASSAGES=true
# Set use_triples=false only for direct-vector ablation; not a separate retriever.
# Set both ranking flags false for retrieval without a chat client.
# Native per-call kwargs for BOTH filtering and reranking; model-dependent.
# Some deployments reject temperature=0; omit/change it as required.
# RAGANITE_RETRIEVAL__LLM_OPTIONS='{"temperature":0.0,"max_tokens":256,"response_format":{"type":"json_object"}}'

# Benchmark credentials live in benchmark/.env. See benchmark/.env.example.

